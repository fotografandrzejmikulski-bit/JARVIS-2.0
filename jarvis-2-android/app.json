{
  "expo": {
    "name": "JARVIS 2.0",
    "slug": "jarvis-2-android",
    "version": "3.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "jarvis",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "27a336a6-0bc8-4fd4-8fda-386f2d5cc136"
      }
    },
    "android": {
      "package": "com.jarvis.commandos",
      "versionCode": 2,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    }
  }
}
